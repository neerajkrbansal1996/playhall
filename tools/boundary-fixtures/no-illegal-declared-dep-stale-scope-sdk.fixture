{
  "name": "@scope/fx-a",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "dependencies": {
    "@stale-scope/game-sdk": "workspace:*",
    "zod": "^3.24.1"
  }
}
