# expect: no-game-to-colyseus
# why: a game expressing its state as a @colyseus/schema class, which makes the SDK contract Colyseus-shaped and hands the game to default-broadcast state sync
=== file: games/fx-a/src/index.ts ===
// The shape ADR-0001 §4.2 named as the sharpest risk of adopting Colyseus, and §4.5 closes:
// game state as a framework Schema. Colyseus then diffs and broadcasts it by default, so a
// field is visible unless someone remembers to filter it — the inversion we do not accept.
// Game state is plain TypeScript. Only apps/realtime's one adapter file names Colyseus.
import { Schema, type } from '@colyseus/schema'

export class BoardState extends Schema {
  @type('string') declare fen: string
  @type('string') declare hiddenDeck: string
}
