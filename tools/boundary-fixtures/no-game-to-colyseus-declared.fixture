  "name": "@scope/fx-a",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "dependencies": {
    "@scope/game-sdk": "workspace:*",
    "@colyseus/schema": "^3.0.0",
    "zod": "^3.24.1"
  }
}
