{
  "name": "@playhall/game-testkit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Conformance suite every game must pass in CI.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./vitest": "./src/vitest.ts",
    "./reference": "./src/reference/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -b && tsc -p tsconfig.test.json",
    "build": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "clean": "rm -rf dist tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@playhall/game-sdk": "workspace:*",
    "@playhall/shared": "workspace:*",
    "zod": "^3.24.1"
  },
  "peerDependencies": {
    "vitest": "^3.0.5"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.0.5",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
