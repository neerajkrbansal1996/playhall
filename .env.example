# Copy to .env for local development. Never commit .env.
# These values match docker-compose.yml and are local-only, not secrets.
#
# The authoritative per-service table, including where each value comes from in
# staging and production, is docs/ENVIRONMENTS.md. This file is the local subset.

DATABASE_URL=postgresql://playhall:playhall@localhost:5432/playhall
REDIS_URL=redis://localhost:6379

# apps/realtime
REALTIME_PORT=3001

# apps/web
NEXT_PUBLIC_REALTIME_URL=http://localhost:3001

# The board approved the product name; packages/shared/src/brand.ts holds it and is
# the only place it may appear. Leave this unset in every normal environment — it is an
# override for environment labelling (e.g. "Playhall (staging)"), not the source of the
# name. Never hard-code a brand string in source.
# NEXT_PUBLIC_BRAND_NAME=
# Domain is still a board decision (PER-2); BRAND.isProvisional stays true while unset.
# NEXT_PUBLIC_BRAND_DOMAIN=

# --- Telemetry (see docs/ENVIRONMENTS.md) ---------------------------------
# Locally: development, the placeholder sha, everything logged, nothing shipped
# to a vendor. CI injects the real values per environment.
DEPLOY_ENV=development
# GIT_SHA=0000000
LOG_LEVEL=debug
# Fraction of non-lifecycle log events kept. Lower under load; do not raise the level.
LOG_SAMPLE_RATE=1

# Sentry ingest keys. A DSN is a write-only ingest key, not a credential, so the
# real values are documented in docs/ENVIRONMENTS.md §2-3 rather than hidden in a
# secret store. They are left unset here on purpose: a developer laptop reporting
# into a free-tier quota shared with an unrelated product burns someone else's
# headroom. Absent = no aggregation, and reports fall back to the structured
# logger instead of vanishing. Uncomment only to reproduce an ingest problem.
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=

# Exposes GET /debug/throw on apps/realtime, which exists only to prove the
# source-map pipeline resolves a stack trace. Never true in production.
ENABLE_DEBUG_THROW_ROUTE=false
