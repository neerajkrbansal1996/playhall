# Copy to .env for local development. Never commit .env.
# These values match docker-compose.yml and are local-only, not secrets.

DATABASE_URL=postgresql://atrium:atrium@localhost:5432/atrium
REDIS_URL=redis://localhost:6379

# apps/realtime
REALTIME_PORT=3001

# apps/web
NEXT_PUBLIC_REALTIME_URL=http://localhost:3001

# Product name is a board decision (PER-2). Until it lands, the brand resolves to
# the internal codename from packages/shared/src/brand.ts. Override here to preview
# a candidate name; never hard-code one in source.
# NEXT_PUBLIC_BRAND_NAME=
