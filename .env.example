# Copy to .env for local development. Never commit .env.
# These values match docker-compose.yml and are local-only, not secrets.

DATABASE_URL=postgresql://playhall:playhall@localhost:5432/playhall
REDIS_URL=redis://localhost:6379

# apps/realtime
REALTIME_PORT=3001

# apps/web
NEXT_PUBLIC_REALTIME_URL=http://localhost:3001

# The board approved the product name; packages/shared/src/brand.ts holds it and is
# the only place it may appear. Leave this unset in every normal environment — it is an
# override for environment labelling (e.g. "Playhall (staging)"), not the source of the
# name. Never hard-code a brand string in source.
# NEXT_PUBLIC_BRAND_NAME=
# Domain is still a board decision (PER-2); BRAND.isProvisional stays true while unset.
# NEXT_PUBLIC_BRAND_DOMAIN=
