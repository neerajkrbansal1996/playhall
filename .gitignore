.claude/settings.local.json

# The repo-root lockfile is the only one we track. A lockfile nested inside a
# workspace package means `pnpm install` was run from inside that package, which
# bypasses workspace resolution and can install a second copy of typescript or
# vitest for that package alone.
pnpm-lock.yaml
!/pnpm-lock.yaml
