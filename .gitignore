# Match a symlinked dependency farm too, which `node_modules/` does not:
# a symlink to a directory is not a directory for gitignore purposes.
node_modules
dist/
.next/
out/
coverage/
*.tsbuildinfo
.turbo/

.env
.env.local
.env.*.local

.DS_Store
*.log
npm-debug.log*
pnpm-debug.log*

.idea/
.vscode/*
!.vscode/extensions.json

# Agent harness local config (machine-specific absolute paths)
.claude/settings.local.json

# Playwright output (PER-131). The `e2e` CI job uploads both as an artifact.
playwright-report/
test-results/
blob-report/
.playwright/
