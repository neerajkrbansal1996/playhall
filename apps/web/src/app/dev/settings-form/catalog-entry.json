{
  "//": "The settingsForm + defaultSettings + presets slice of a GameCatalogEntry, exactly as it arrives over the wire. Transcribed from games/chess/src/settings/form.ts; NOT imported from it, because apps/web may not import a game package (ADR-0002). Used only by the flag-gated measurement harness.",
  "name": "Chess",
  "defaultSettings": {
    "timeControl": "5+0",
    "customInitialMinutes": 5,
    "customIncrementSeconds": 0,
    "color": "random",
    "takebacks": false,
    "autoQueen": false
  },
  "settingsForm": {
    "version": 1,
    "fields": [
      {
        "kind": "select",
        "key": "timeControl",
        "label": "Time control",
        "display": "chips",
        "options": [
          { "value": "1+0", "label": "1+0", "group": "Bullet" },
          { "value": "2+1", "label": "2+1", "group": "Bullet" },
          { "value": "3+0", "label": "3+0", "group": "Blitz" },
          { "value": "3+2", "label": "3+2", "group": "Blitz" },
          { "value": "5+0", "label": "5+0", "group": "Blitz" },
          { "value": "5+3", "label": "5+3", "group": "Blitz" },
          { "value": "10+0", "label": "10+0", "group": "Rapid" },
          { "value": "10+5", "label": "10+5", "group": "Rapid" },
          { "value": "15+10", "label": "15+10", "group": "Rapid" },
          { "value": "30+0", "label": "30+0", "group": "Classical" },
          { "value": "custom", "label": "Custom", "group": "Other" },
          { "value": "unlimited", "label": "No clock", "group": "Other" }
        ],
        "groupOrder": ["Bullet", "Blitz", "Rapid", "Classical", "Other"]
      },
      {
        "kind": "number",
        "key": "customInitialMinutes",
        "label": "Minutes per side",
        "unit": "min",
        "min": 0.5,
        "max": 180,
        "step": 0.5,
        "visibleWhen": { "field": "timeControl", "equals": ["custom"] }
      },
      {
        "kind": "number",
        "key": "customIncrementSeconds",
        "label": "Increment",
        "unit": "s",
        "help": "Added to your clock after each move you make.",
        "min": 0,
        "max": 60,
        "step": 1,
        "visibleWhen": { "field": "timeControl", "equals": ["custom"] }
      },
      {
        "kind": "select",
        "key": "color",
        "label": "Colour",
        "display": "chips",
        "options": [
          { "value": "white", "label": "White" },
          { "value": "black", "label": "Black" },
          { "value": "random", "label": "Random" }
        ]
      },
      {
        "kind": "toggle",
        "key": "takebacks",
        "label": "Allow takebacks",
        "help": "Your opponent can ask to take back their last move."
      },
      {
        "kind": "toggle",
        "key": "autoQueen",
        "label": "Auto-promote to queen",
        "help": "Skip the promotion picker and always promote to a queen."
      }
    ]
  },
  "presets": [
    {
      "id": "bullet-1-0",
      "label": "Bullet",
      "description": "1 minute each, no increment.",
      "isDefault": false,
      "featured": false,
      "settings": {
        "timeControl": "1+0",
        "customInitialMinutes": 5,
        "customIncrementSeconds": 0,
        "color": "random",
        "takebacks": false,
        "autoQueen": false
      }
    },
    {
      "id": "blitz-3-2",
      "label": "Blitz 3+2",
      "description": "3 minutes each, 2 seconds a move.",
      "isDefault": false,
      "featured": true,
      "settings": {
        "timeControl": "3+2",
        "customInitialMinutes": 5,
        "customIncrementSeconds": 0,
        "color": "random",
        "takebacks": false,
        "autoQueen": false
      }
    },
    {
      "id": "blitz-5-0",
      "label": "Blitz 5+0",
      "description": "5 minutes each, no increment.",
      "isDefault": true,
      "featured": true,
      "settings": {
        "timeControl": "5+0",
        "customInitialMinutes": 5,
        "customIncrementSeconds": 0,
        "color": "random",
        "takebacks": false,
        "autoQueen": false
      }
    },
    {
      "id": "rapid-10-0",
      "label": "Rapid 10+0",
      "description": "10 minutes each, no increment.",
      "isDefault": false,
      "featured": true,
      "settings": {
        "timeControl": "10+0",
        "customInitialMinutes": 5,
        "customIncrementSeconds": 0,
        "color": "random",
        "takebacks": false,
        "autoQueen": false
      }
    },
    {
      "id": "rapid-15-10",
      "label": "Rapid 15+10",
      "description": "15 minutes each, 10 seconds a move.",
      "isDefault": false,
      "featured": false,
      "settings": {
        "timeControl": "15+10",
        "customInitialMinutes": 5,
        "customIncrementSeconds": 0,
        "color": "random",
